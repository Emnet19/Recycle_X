# ==============================================================================
# RecycleX Backend Environment Configuration Template
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/recyclex_db

# JWT Secrets (Generate secure 256-bit keys for production)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing (Argon2id configuration defaults)
ARGON_TIME_COST=3
ARGON_MEMORY_COST=65536
ARGON_PARALLELISM=4

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

