# ==============================================================================
# RecycleX Monorepo – Root .gitignore
# ==============================================================================
# Each sub-project (frontend/, backend/) also has its own .gitignore.
# This file covers repository-level and OS/IDE artifacts.

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor
.vscode/
.idea/
*.suo
*.user
*.userosv
*.iml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend – never commit secrets or compiled output from monorepo root
backend/.env
backend/.env.*
!backend/.env.example
backend/node_modules/
backend/dist/

# Frontend – never commit Flutter build artifacts or secrets from monorepo root
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub/
frontend/.pub-preload-cache/
frontend/coverage/

# Scratch files
server-test-err.txt
server-test-out.txt
